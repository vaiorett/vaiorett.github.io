---
const {lang='zh',project=false}=Astro.props;
const root=lang==='en'?'../':'./',file=project?'work-__project__.html':'index.html';
const t=(key)=>`@@ui.${lang}.${key}@@`;
const title=project?`@@project.__project__.${lang}.title@@ · ${t('name')}`:t('title');
const description=project?`@@project.__project__.${lang}.desc@@`:t('description');
const image=project?'@@cover.__project__@@':'@@cover.yunba-depot@@';
const canonical=(code)=>'https://vaiorett.github.io/'+(code==='en'?'en/':'')+(file==='index.html'?'':file);
const schema={'@context':'https://schema.org','@type':'WebPage',name:title,description,url:canonical(lang),inLanguage:lang==='en'?'en':'zh-CN',about:{'@type':'Person',name:t('name'),alternateName:'@@site.brand@@',url:'https://vaiorett.github.io/'},primaryImageOfPage:{'@type':'ImageObject',contentUrl:'https://vaiorett.github.io/'+image}};
const version='20261025-koibumi11';
---
<!doctype html>
<html lang={lang==='en'?'en':'zh-CN'}>
<head>
<meta charset="utf-8"><meta name="robots" content="noindex"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark"><script is:inline src={root+'theme.js?v='+version}></script>
<title>{title}</title><meta name="description" content={description}>
<link rel="canonical" href={canonical(lang)}>
<link rel="alternate" hreflang="zh-CN" href={canonical('zh')}><link rel="alternate" hreflang="en" href={canonical('en')}><link rel="alternate" hreflang="x-default" href={canonical('zh')}>
<meta property="og:type" content="website"><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={canonical(lang)}><meta property="og:image" content={'https://vaiorett.github.io/'+image}><meta property="og:image:alt" content={title}><meta property="og:locale" content={lang==='en'?'en_US':'zh_CN'}><meta property="og:locale:alternate" content={lang==='en'?'zh_CN':'en_US'}><meta name="twitter:card" content="summary_large_image">
<link rel="icon" href={root+'favicon.svg'} type="image/svg+xml">
<link rel="stylesheet" href={root+'style.css?v='+version}><link rel="stylesheet" href={root+'theme.css?v='+version}><link rel="stylesheet" href={root+'portfolio.css?v='+version}>
<Fragment set:html={'<script type="application/ld+json">'+JSON.stringify(schema)+'</script>'}/>
<script is:inline src={root+'video-core.js?v='+version} defer></script><script is:inline src={root+'layout-core.js?v='+version} defer></script><script is:inline src={root+'gallery-data.js?v=@@galleryVersion@@'} defer></script><script is:inline src={root+'ui.js?v='+version} defer></script><script is:inline src={root+'app.js?v='+version} defer></script>
</head>
<body data-root={root} data-page={project?'__project__':'home'} class="portfolio-site">
<a class="skip-link" href="#main">{t('skip')}</a>
<header class="site-header"><div class="nav-wrap">
<a class="brand" href="./index.html" aria-label={t('name')+' · '+t('home')}><span class="brand-mark" aria-hidden="true">v<span>·</span></span><span class="brand-name">@@site.brand@@<span>3D &amp; VISUALIZATION</span></span></a>
<nav aria-label={t('nav')}><a class="md link-button button-light-primary" href="./index.html#work">{t('work')}</a><a class="md link-button button-light-primary" href="./index.html#about">{t('about')}</a><a class="md link-button button-light-primary" href="./index.html#contact">{t('contact')}</a></nav>
<div class="nav-preferences"><div class="language-switch" role="group" aria-label="Language / 语言">{['zh','en'].map(code=><a class={'md link-button '+(lang===code?'button-solid-primary':'button-light-primary')} href={(code==='zh'?(lang==='en'?'../':'./'):(lang==='en'?'./':'./en/'))+file} lang={code} hreflang={code} data-language={code} aria-current={lang===code?'page':undefined}>{code==='zh'?'中文':'English'}</a>)}</div>
<label class="theme-control"><span class="sr-only">{lang==='zh'?'显示主题':'Appearance'}</span><select data-theme-select aria-label={lang==='zh'?'显示主题':'Appearance'}><option value="system">{lang==='zh'?'跟随系统':'System'}</option><option value="light">{lang==='zh'?'浅色':'Light'}</option><option value="dark">{lang==='zh'?'深色':'Dark'}</option></select></label></div>
</div></header>
<main id="main"><slot/></main>
<footer class="site-footer"><span>© 2026 @@site.brand@@</span><span>{t('footer')}</span><div class="footer-links"><a href={root+'manage.html'}>{t('manager')}</a></div></footer><button class="back-top" type="button" aria-label={t('top')} hidden>↑</button>
</body></html>
