---
import Portfolio from '../layouts/Portfolio.astro';
const {lang}=Astro.props,root=lang==='en'?'../':'./';
const t=k=>`@@ui.${lang}.${k}@@`,h=k=>`@@home.${lang}.${k}@@`;
import schema from '../data/schema.json';
const jobIndices=[...new Set(Object.keys(schema.fields).filter(k=>k.startsWith('profile.experience.')).map(k=>Number(k.split('.')[2])))];
const educationIndices=[...new Set(Object.keys(schema.fields).filter(k=>k.startsWith('profile.education.')).map(k=>Number(k.split('.')[2])))];
---
<Portfolio lang={lang}>
<section class="hero wrap" aria-labelledby="intro-title"><div class="hero-copy"><p class="eyebrow accent">{t('name')} / {h('kicker')}</p><h1 id="intro-title">{h('hero')}<br><span>{h('heroAccent')}</span></h1><p class="hero-intro">{h('intro')}</p><div class="hero-actions"><a class="button primary" href="#work">{t('work')} ↓</a><a class="text-link" href="#contact">{lang==='zh'?'联系我':'Get in touch'} ↗</a></div></div>
<a class="hero-art" href="./work-yunba-depot.html" aria-label={`@@project.yunba-depot.${lang}.title@@`}><img src={root+'@@cover.yunba-depot@@'} alt={`@@project.yunba-depot.${lang}.title@@`} width="1033" height="634" fetchpriority="high"><div class="hero-art-caption"><span>{t('architecture')}</span><span>{`@@project.yunba-depot.${lang}.title@@`} <b aria-hidden="true">↗</b></span></div></a></section>
<section id="work" class="work-section wrap" aria-labelledby="work-title"><div class="section-top"><div><p class="eyebrow accent">01 / {t('work')}</p><h2 id="work-title">{h('workTitle')}<span class="section-count">@@total.all@@</span></h2></div><p class="section-description">{h('workIntro')}</p></div>
<div class="filter-bar" role="group" aria-label={t('filter')} hidden>{['all','architecture','assets','product','studies'].map((key,i)=><button type="button" class={'filter '+(i===0?'active':'')} data-filter={key} aria-pressed={i===0?'true':'false'}>{t(key)} <span>{`@@total.${key}@@`}</span></button>)}</div><p class="sr-only" id="filter-status" aria-live="polite"></p><div class="project-grid">{`@@cards.${lang}@@`}</div></section>
<section id="capabilities" class="capability-section wrap"><div class="section-top"><div><p class="eyebrow accent">02 / {t('capabilities')}</p><h2>{h('capTitle')}</h2></div></div><div class="capability-grid">{['grandstand','digital-assets','product-rendering'].map((id,i)=><a class="capability" href={'./work-'+id+'.html'}><span class="capability-number">0{i+1}</span><h3>{`@@cap.${lang}.${i}.0@@`}</h3><p>{`@@cap.${lang}.${i}.1@@`}</p><p class="tool-line">{`@@cap.${lang}.${i}.2@@`}</p><span class="capability-link">{t('view')} ↗</span></a>)}</div></section>
<section id="about" class="about-section wrap"><div class="section-top"><div><p class="eyebrow accent">03 / {t('about')}</p><h2>{h('aboutTitle')}</h2></div><div class="about-intro">{h('aboutIntro')}</div></div><div class="about-columns"><div><h3 class="small-heading">{t('experience')}</h3><ol class="timeline">{jobIndices.map(i=><li><h4>{`@@profile.experience.${i}.${lang}.0@@`}</h4><p>{`@@profile.experience.${i}.${lang}.1@@`}</p><p class="timeline-detail">{`@@profile.experience.${i}.${lang}.2@@`}</p></li>)}</ol></div><div><h3 class="small-heading">{t('education')}</h3>{educationIndices.map(i=><div class="education-item"><h4>{`@@profile.education.${i}.${lang}.0@@`}</h4><p>{`@@profile.education.${i}.${lang}.1@@`}</p></div>)}<h3 class="small-heading skills-heading">{t('alltools')}</h3><div class="skill-tags">@@profile.tools@@</div><div class="certificates"><h3 class="small-heading">{t('certificates')}</h3>{`@@profile.certificates.${lang}@@`}</div></div></div></section>
<section id="contact" class="contact-section wrap"><div><p class="eyebrow accent">04 / {t('contact')}</p><h2>{h('contactTitle')}</h2><p>{h('contactIntro')}</p></div><div class="contact-links"><a href="mailto:@@site.email@@">@@site.email@@ ↗</a><button type="button" class="copy-email" data-email="@@site.email@@" hidden>{t('copy')}</button><p class="copy-status" role="status"></p></div></section>
</Portfolio>
