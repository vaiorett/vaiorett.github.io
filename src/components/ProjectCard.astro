---
const {lang}=Astro.props,root=lang==='en'?'../':'./',p=k=>`@@project.__project__.${lang}.${k}@@`;
---
<article class="project-card" data-project-card="__project__" data-category="@@group.__project__@@"><a href="./work-__project__.html" class="project-link"><div class="project-image"><img src={`@@cardcover.__project__.${lang}@@`} data-card-fallback={`@@cardfallback.__project__.${lang}@@`} referrerpolicy="no-referrer" alt={p('title')} loading="lazy" decoding="async" width="800" height="570"><span class="project-open" aria-hidden="true">↗</span></div><div class="project-card-copy"><div class="project-meta"><span class="eyebrow">{`@@category.__project__.${lang}@@`}</span></div><h3>{p('title')}</h3><p class="project-role">{p('role')}</p><p class="card-description">{p('desc')}</p><p class="card-tools">{p('tools')}</p></div></a></article>
